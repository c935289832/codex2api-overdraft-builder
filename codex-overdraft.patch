+func overdraftTestAccount(plan string) *auth.Account {
+	return &auth.Account{
+		DBID:                42,
+		AccessToken:         "access-token",
+		PlanType:            plan,
+		UsagePercent5h:      95,
+		UsagePercent5hValid: true,
+		Reset5hAt:           time.Now().Add(time.Hour),
+		UsagePercent7d:      20,
+		UsagePercent7dValid: true,
+		Reset7dAt:           time.Now().Add(24 * time.Hour),
+	}
+}
+
+func overdraftTestBody(t *testing.T) []byte {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{
+		"model": "gpt-5.4",
+		"input": []map[string]any{{
+			"type": "message", "role": "user", "content": []map[string]string{{"type": "input_text", "text": "hello"}},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return body
+}
+
+func TestCodexQuotaOverdraftInjectionSwitchAndThreshold(t *testing.T) {
+	account := overdraftTestAccount("plus")
+	body := overdraftTestBody(t)
+	auth.SetCodexQuotaOverdraftEnabled(false)
+	if got, injected := prepareCodexQuotaOverdraftBody(context.Background(), account, body); injected || string(got) != string(body) {
+		t.Fatal("disabled switch changed request")
+	}
+	auth.SetCodexQuotaOverdraftEnabled(true)
+	account.UsagePercent5h = 94
+	if _, injected := prepareCodexQuotaOverdraftBody(context.Background(), account, body); injected {
+		t.Fatal("94% usage should not inject")
+	}
+	account.UsagePercent5h = 95
+	got, injected := prepareCodexQuotaOverdraftBody(context.Background(), account, body)
+	if !injected || !codexQuotaOverdraftBodyHasInjection(got) {
+		t.Fatal("95% usage should inject")
+	}
+	if again, injected := prepareCodexQuotaOverdraftBody(context.Background(), account, got); injected || string(again) != string(got) {
+		t.Fatal("duplicate injection should be idempotent")
+	}
+	auth.SetCodexQuotaOverdraftEnabled(false)
+}
+
+func TestCodexQuotaOverdraftSupportsPlusAndTeamButExcludesRelayAndProbe(t *testing.T) {
+	auth.SetCodexQuotaOverdraftEnabled(true)
+	defer auth.SetCodexQuotaOverdraftEnabled(false)
+	for _, plan := range []string{"plus", "team"} {
+		got, injected := prepareCodexQuotaOverdraftBody(context.Background(), overdraftTestAccount(plan), overdraftTestBody(t))
+		if !injected || !strings.Contains(string(got), "custom_tool_call") {
+			t.Fatalf("%s account was not injected", plan)
+		}
+	}
+	relay := overdraftTestAccount("plus")
+	relay.UpstreamType = auth.UpstreamOpenAIResponses
+	relay.BaseURL = "https://api.example.test"
+	relay.APIKey = "api-key"
+	if _, injected := prepareCodexQuotaOverdraftBody(context.Background(), relay, overdraftTestBody(t)); injected {
+		t.Fatal("API relay must not receive Codex overdraft payload")
+	}
+	probeCtx := context.WithValue(context.Background(), codexQuotaOverdraftProbeContextKey{}, true)
+	if _, injected := prepareCodexQuotaOverdraftBody(probeCtx, overdraftTestAccount("plus"), overdraftTestBody(t)); injected {
+		t.Fatal("probe request must not recurse")
+	}
+}
+
+func TestCodexQuotaOverdraftProbeClassification(t *testing.T) {
+	if status, _ := classifyCodexQuotaOverdraftProbe(200, nil, []byte(`data: {"type":"response.completed"}`)); status != auth.CodexQuotaOverdraftPassed {
+		t.Fatalf("completed probe status=%q", status)
+	}
+	if status, _ := classifyCodexQuotaOverdraftProbe(429, nil, []byte(`{"error":{"code":"usage_limit_reached"}}`)); status != auth.CodexQuotaOverdraftFailed {
+		t.Fatalf("quota probe status=%q", status)
+	}
+}
