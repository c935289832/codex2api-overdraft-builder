@@ -0,0 +1,46 @@
+package auth
+
+import (
+	"testing"
+	"time"
+)
+
+func TestCodexQuotaOverdraftSchedulingBypassesOnlyUsageGates(t *testing.T) {
+	SetCodexQuotaOverdraftEnabled(true)
+	defer SetCodexQuotaOverdraftEnabled(false)
+	now := time.Now()
+	account := &Account{
+		DBID:                    7,
+		AccessToken:             "token",
+		PlanType:                "plus",
+		Status:                  StatusCooldown,
+		CooldownReason:          "rate_limited_5h",
+		CooldownUtil:            now.Add(time.Hour),
+		UsagePercent5h:          100,
+		UsagePercent5hValid:     true,
+		Reset5hAt:               now.Add(time.Hour),
+		UsagePercent7d:          20,
+		UsagePercent7dValid:     true,
+		Reset7dAt:               now.Add(24 * time.Hour),
+		DynamicConcurrencyLimit: 1,
+	}
+	if !account.CodexQuotaOverdraftSchedulingAllowed(now) {
+		t.Fatal("100% plus account should be eligible for overdraft scheduling")
+	}
+	if !account.IsAvailable() {
+		t.Fatal("usage-window cooldown should be bypassed")
+	}
+	account.Status = StatusError
+	if account.IsAvailable() {
+		t.Fatal("authentication/error state must not be bypassed")
+	}
+}
+
+func TestCodexQuotaOverdraftRelayExcludedWithoutRecursiveLock(t *testing.T) {
+	SetCodexQuotaOverdraftEnabled(true)
+	defer SetCodexQuotaOverdraftEnabled(false)
+	account := &Account{DBID: 8, AccessToken: "token", UpstreamType: UpstreamOpenAIResponses, BaseURL: "https://relay.example", APIKey: "key", UsagePercent5h: 100, UsagePercent5hValid: true, Reset5hAt: time.Now().Add(time.Hour)}
+	if account.CodexQuotaOverdraftSchedulingAllowed(time.Now()) {
+		t.Fatal("relay account must be excluded")
+	}
+}
