diff --git a/auth/codex_quota_overdraft.go b/auth/codex_quota_overdraft.go
new file mode 100644
index 0000000..bba1233
--- /dev/null
+++ b/auth/codex_quota_overdraft.go
@@ -0,0 +1,201 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"log"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	CodexQuotaOverdraftPending      = "pending"
+	CodexQuotaOverdraftPassed       = "passed"
+	CodexQuotaOverdraftFailed       = "failed"
+	CodexQuotaOverdraftInconclusive = "inconclusive"
+	CodexQuotaOverdraftRecovered    = "recovered"
+)
+
+var codexQuotaOverdraftEnabled atomic.Bool
+
+// SetCodexQuotaOverdraftEnabled publishes the process-wide feature switch to
+// the account schedulers. The switch defaults to false.
+func SetCodexQuotaOverdraftEnabled(enabled bool) {
+	codexQuotaOverdraftEnabled.Store(enabled)
+}
+
+// CodexQuotaOverdraftEnabled reports whether quota-overdraft scheduling and
+// request mutation are enabled for this process.
+func CodexQuotaOverdraftEnabled() bool {
+	return codexQuotaOverdraftEnabled.Load()
+}
+
+// CodexQuotaOverdraftSnapshot is persisted in the account credentials JSON.
+// It intentionally contains no tokens or response bodies.
+type CodexQuotaOverdraftSnapshot struct {
+	Status    string    `json:"status"`
+	Window    string    `json:"quota_window,omitempty"`
+	CycleKey  string    `json:"cycle_key,omitempty"`
+	Attempts  int       `json:"attempts,omitempty"`
+	Model     string    `json:"model,omitempty"`
+	Reason    string    `json:"reason_code,omitempty"`
+	StartedAt time.Time `json:"started_at,omitempty"`
+	TestedAt  time.Time `json:"tested_at,omitempty"`
+	RecoverAt time.Time `json:"recover_at,omitempty"`
+}
+
+func (a *Account) codexQuotaOverdraftSchedulingAllowedLocked(now time.Time) bool {
+	if a == nil || a.isRelayStyleLocked() {
+		return false
+	}
+	status := strings.ToLower(strings.TrimSpace(a.CodexQuotaOverdraftStatus))
+	if status == CodexQuotaOverdraftFailed &&
+		(a.CodexQuotaOverdraftRecoverAt.IsZero() || a.CodexQuotaOverdraftRecoverAt.After(now)) {
+		return false
+	}
+	if a.CodexQuotaOverdraftRecoverAt.After(now) {
+		switch status {
+		case CodexQuotaOverdraftPending, CodexQuotaOverdraftPassed, CodexQuotaOverdraftInconclusive:
+			return true
+		case CodexQuotaOverdraftFailed:
+			return false
+		}
+	}
+	// Prearm at 95% so the scheduler can still reach the 100% observation.
+	if a.UsagePercent5hValid && (a.Reset5hAt.IsZero() || a.Reset5hAt.After(now)) && a.UsagePercent5h >= 95 {
+		return true
+	}
+	if a.UsagePercent7dValid && (a.Reset7dAt.IsZero() || a.Reset7dAt.After(now)) && a.UsagePercent7d >= 95 {
+		return true
+	}
+	return false
+}
+
+func (a *Account) codexQuotaOverdraftUsageGateBypassLocked(now time.Time) bool {
+	return CodexQuotaOverdraftEnabled() && a.codexQuotaOverdraftSchedulingAllowedLocked(now)
+}
+
+func (a *Account) codexQuotaOverdraftUsageCooldownLocked(now time.Time) bool {
+	if a.usageWindowCooldownLocked() {
+		return true
+	}
+	if a.Status != StatusCooldown || !now.Before(a.CooldownUtil) {
+		return false
+	}
+	switch a.CooldownReason {
+	case "rate_limited_5h":
+		return a.rawPremium5hRateLimitedLocked(now)
+	case "rate_limited", "rate_limited_7d", "usage_limited", "usage_limit":
+		return a.rawUsageWindow7dExhaustedLocked(now) || a.rawPremium5hRateLimitedLocked(now)
+	default:
+		return false
+	}
+}
+
+// CodexQuotaOverdraftSchedulingAllowed reports whether local usage-window
+// gates may be bypassed for this account. Authentication, disabled and model
+// cooldown gates remain enforced by the normal scheduler.
+func (a *Account) CodexQuotaOverdraftSchedulingAllowed(now time.Time) bool {
+	if a == nil || !CodexQuotaOverdraftEnabled() {
+		return false
+	}
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	return a.codexQuotaOverdraftSchedulingAllowedLocked(now)
+}
+
+func (a *Account) SetCodexQuotaOverdraftSnapshot(snapshot CodexQuotaOverdraftSnapshot) {
+	if a == nil {
+		return
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.CodexQuotaOverdraftStatus = snapshot.Status
+	a.CodexQuotaOverdraftWindow = snapshot.Window
+	a.CodexQuotaOverdraftCycleKey = snapshot.CycleKey
+	a.CodexQuotaOverdraftRecoverAt = snapshot.RecoverAt
+	a.CodexQuotaOverdraftAttempts = snapshot.Attempts
+	a.CodexQuotaOverdraftModel = snapshot.Model
+	a.CodexQuotaOverdraftReason = snapshot.Reason
+	a.CodexQuotaOverdraftStartedAt = snapshot.StartedAt
+	a.CodexQuotaOverdraftTestedAt = snapshot.TestedAt
+}
+
+func (a *Account) CodexQuotaOverdraftSnapshot() CodexQuotaOverdraftSnapshot {
+	if a == nil {
+		return CodexQuotaOverdraftSnapshot{}
+	}
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	return CodexQuotaOverdraftSnapshot{
+		Status:    a.CodexQuotaOverdraftStatus,
+		Window:    a.CodexQuotaOverdraftWindow,
+		CycleKey:  a.CodexQuotaOverdraftCycleKey,
+		RecoverAt: a.CodexQuotaOverdraftRecoverAt,
+		Attempts:  a.CodexQuotaOverdraftAttempts,
+		Model:     a.CodexQuotaOverdraftModel,
+		Reason:    a.CodexQuotaOverdraftReason,
+		StartedAt: a.CodexQuotaOverdraftStartedAt,
+		TestedAt:  a.CodexQuotaOverdraftTestedAt,
+	}
+}
+
+func (a *Account) RestoreCodexQuotaOverdraftJSON(raw string) bool {
+	var snapshot CodexQuotaOverdraftSnapshot
+	if strings.TrimSpace(raw) == "" || json.Unmarshal([]byte(raw), &snapshot) != nil || snapshot.Status == "" {
+		return false
+	}
+	a.SetCodexQuotaOverdraftSnapshot(snapshot)
+	return true
+}
+
+// PersistCodexQuotaOverdraftSnapshot updates memory and the existing
+// credentials JSON document. A confirmed failure is terminal for its cycle, so
+// a late success/inconclusive probe cannot overwrite it.
+func (s *Store) PersistCodexQuotaOverdraftSnapshot(acc *Account, snapshot CodexQuotaOverdraftSnapshot) bool {
+	if acc == nil || strings.TrimSpace(snapshot.Status) == "" {
+		return false
+	}
+
+	acc.mu.Lock()
+	if acc.CodexQuotaOverdraftCycleKey == snapshot.CycleKey &&
+		acc.CodexQuotaOverdraftStatus == CodexQuotaOverdraftFailed &&
+		snapshot.Status != CodexQuotaOverdraftFailed {
+		acc.mu.Unlock()
+		return false
+	}
+	acc.CodexQuotaOverdraftStatus = snapshot.Status
+	acc.CodexQuotaOverdraftWindow = snapshot.Window
+	acc.CodexQuotaOverdraftCycleKey = snapshot.CycleKey
+	acc.CodexQuotaOverdraftRecoverAt = snapshot.RecoverAt
+	acc.CodexQuotaOverdraftAttempts = snapshot.Attempts
+	acc.CodexQuotaOverdraftModel = snapshot.Model
+	acc.CodexQuotaOverdraftReason = snapshot.Reason
+	acc.CodexQuotaOverdraftStartedAt = snapshot.StartedAt
+	acc.CodexQuotaOverdraftTestedAt = snapshot.TestedAt
+	if s != nil {
+		acc.recomputeSchedulerLocked(atomic.LoadInt64(&s.maxConcurrency))
+	}
+	acc.mu.Unlock()
+
+	if s != nil {
+		s.fastSchedulerUpdate(acc)
+	}
+	if s == nil || s.db == nil || acc.DBID == 0 {
+		return true
+	}
+	raw, err := json.Marshal(snapshot)
+	if err == nil {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		err = s.db.UpdateCredentials(ctx, acc.DBID, map[string]interface{}{
+			"codex_quota_overdraft": string(raw),
+		})
+		cancel()
+	}
+	if err != nil {
+		log.Printf("[账号 %d] 持久化 Codex 额度透支状态失败: %v", acc.DBID, err)
+		return false
+	}
+	return true
+}
